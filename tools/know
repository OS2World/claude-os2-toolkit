# ----------------------------------------------------------- store location

def db_path():
    """$OS2_KNOW_DB -> ${XDG_DATA_HOME:-~/.local/share}/os2-toolkit/know.db.

    Outside the library on purpose -- see the module docstring: chunks are
    re-ingestable, facts and negative results are not.
    """
    v = os.environ.get("OS2_KNOW_DB")
    if v:
        return os.path.abspath(os.path.expanduser(v))
    base = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
    return os.path.join(base, "os2-toolkit", "know.db")


_MIGRATIONS = [
    ("fact",   "corroboration", "TEXT NOT NULL DEFAULT 'self'"),
    ("fact",   "verify_cmd2",   "TEXT"),
    ("search", "verify_cmd",    "TEXT"),
    ("search", "superseded_by", "INTEGER REFERENCES search(id)"),
    ("chunk",  "size",          "INTEGER"),
    ("chunk",  "mtime",         "INTEGER"),
]


def migrate(conn):
    """Idempotent ADD COLUMN for stores created before a column existed. The
    DDL uses CREATE TABLE IF NOT EXISTS, which silently does nothing to an
    existing table -- so without this a schema change is invisible until a
    query fails."""
    for table, col, decl in _MIGRATIONS:
        try:
            cols = {r[1] for r in conn.execute(f"PRAGMA table_info({table})")}
        except sqlite3.OperationalError:
            continue                       # table not created yet
        if cols and col not in cols:
            conn.execute(f"ALTER TABLE {table} ADD COLUMN {col} {decl}")
    conn.commit()


def connect(create=False):
    p = db_path()
    if not os.path.exists(p):
        if not create:
            die(f"no store at {p}\n"
                f"       run `know init`, or point $OS2_KNOW_DB at an existing store")
        d = os.path.dirname(p)
        if d:
            os.makedirs(d, exist_ok=True)
    c = sqlite3.connect(p)
    c.row_factory = sqlite3.Row
    migrate(c)
    try:
        c.execute("SELECT 1 FROM fact_fts LIMIT 1").fetchone()
    except sqlite3.OperationalError:
        if not create:
            die("FTS index missing or unusable -- the store is damaged.\n"
                "       Rebuild: know init")
    return c


def die(msg, code=2):
    print(f"know: {msg}", file=sys.stderr)
    sys.exit(code)


# ------------------------------------------------------------------ chunkers

MAX_CHUNK, MIN_CHUNK = 6000, 120


def _postprocess(chunks):
    """Enforce MAX_CHUNK/MIN_CHUNK. Measured on a real markdown corpus: a bare
    `##` split leaves 49 chunks over 12 KB and one at 213 KB, so a size cap is
    not optional. The overlap of one paragraph at each seam is what stops a
    declaration or a sentence being lost between two chunks."""
    out = []
    for heading, body in chunks:
        body = body.strip("\n")
        if not body.strip():
            continue
        if len(body) <= MAX_CHUNK:
            out.append((heading, body))
            continue
        cur, n, part = [], 0, 1
        for para in body.split("\n\n"):
            if n + len(para) > MAX_CHUNK and cur:
                out.append(((heading or "") + f" [{part}]", "\n\n".join(cur)))
                part += 1
                cur = [cur[-1]] if len(cur) > 1 else []   # one-para overlap
                n = sum(len(x) for x in cur)
            cur.append(para)
            n += len(para)
        if cur:
            out.append(((heading or "") + f" [{part}]", "\n\n".join(cur)))
    merged, carry = [], None
    for heading, body in out:
        if carry:
            heading, body, carry = carry[0] or heading, carry[1] + "\n\n" + body, None
        if len(body) < MIN_CHUNK:
            carry = (heading, body)
            continue
        merged.append((heading, body))
    if carry:
        if merged:
            merged[-1] = (merged[-1][0], merged[-1][1] + "\n\n" + carry[1])
        else:
            merged.append(carry)
    return merged


def chunk_inf(text):
    """INF-book text as `inf2txt.sh` writes it: sections are '=== Heading ==='.

    This is the material that chunks best with no tuning at all: each API's
    syntax and each parameter land as their own section, which is exactly the
    granularity a question is asked at."""
    parts = re.split(r"(?m)^=== (.*?) ===$\n?", text)
    out = [(None, parts[0])] if parts and parts[0].strip() else []
    for i in range(1, len(parts) - 1, 2):
        out.append((parts[i].strip(), parts[i + 1]))
    return _postprocess(out)


def chunk_md(text):
    parts = re.split(r"(?m)^(#{2,3}) (.*)$\n?", text)
    out = [(None, parts[0])] if parts and parts[0].strip() else []
    for i in range(1, len(parts) - 2, 3):
        out.append((parts[i + 1].strip(), parts[i + 2]))
    return _postprocess(out)


_RB = re.compile(r"(?m)^\s{0,4}((?:\d+\.)*\d+)\s+([A-Z][^\n]{2,70})$")


def chunk_redbook(text):
    """Plain book text: numbered headings. Falls back to fixed windows where
    scanning or OCR left none -- a silent zero-chunk result is not acceptable,
    because it is indistinguishable from material that says nothing."""
    marks = [(m.start(), f"{m.group(1)} {m.group(2).strip()}") for m in _RB.finditer(text)]
    if len(marks) < 5:
        return _postprocess([(None, text[i:i + 3400]) for i in range(0, len(text), 3000)])
    out = [(None, text[:marks[0][0]])] if marks[0][0] else []
    for i, (pos, head) in enumerate(marks):
        end = marks[i + 1][0] if i + 1 < len(marks) else len(text)
        out.append((head, text[pos:end]))
    return _postprocess(out)


# A named declaration at column 0: what a reader greps a header FOR.
_DECL = re.compile(
    r"(?m)^\s{0,2}(?:"
    r"#define\s+(?P<d>[A-Za-z_][A-Za-z0-9_]*)"
    r"|(?:typedef\s+)?(?:struct|union|enum)\s+(?P<s>[A-Za-z_][A-Za-z0-9_]*)"
    r"|(?P<a>[A-Za-z_][A-Za-z0-9_]*)\s+(?:STRUC|EQU|PROC|MACRO|SEGMENT)\b"
    r"|[A-Za-z_][A-Za-z0-9_ \t*]*?(?P<f>[A-Za-z_][A-Za-z0-9_]*)\s*\([^;{]*\)\s*[;{]"
    r")")


def chunk_source(text):
    """C/asm headers and driver source.

    Fixed windows, NOT declaration boundaries. A header is not a document and
    has no reliable section structure: `#define` runs, struct bodies, prototype
    blocks and 200-line comment banners all interleave, and every boundary rule
    tried on real IBM headers either split a struct across two chunks or
    swallowed a whole file into one. Windows with overlap cannot lose a
    declaration at a seam, which is the only failure that matters here --
    retrieval is FTS, so what a chunk needs is to CONTAIN the terms, not to
    start in the right place.

    The heading is the first named declaration in the window, because that is
    what makes a hit legible in a result list ("bsedos.h sec. DosQFileMode"
    beats "bsedos.h chunk 47"). It is a label, not a claim about the chunk's
    extent."""
    out, step, win = [], 2400, 2800
    for i in range(0, max(len(text), 1), step):
        body = text[i:i + win]
        if not body.strip():
            continue
        m = _DECL.search(body)
        head = None
        if m:
            head = m.group("d") or m.group("s") or m.group("a") or m.group("f")
        out.append((head, body))
    return _postprocess(out)


class _HtmlText(HTMLParser):
    """Visible text of one HTML book page or article, split at its headings.

    IBM's HTML reference books are one ARTICLE per page: the <title> and a
    leading <h2> carry the book name, one <h3> carries the article title, and
    the body is <p>/<br>/<pre>/<ul> with much of the punctuation as numeric
    entities. Some books are not paginated that way and put a whole manual in
    one file with many <h2>/<h3> -- so headings of any level open a new section,
    and a page with none is one section titled by its <title>. Text inside <pre>
    keeps its line structure (that is where the tables are); everything else has
    whitespace collapsed. Wiki and blog mirrors chunk acceptably under the same
    rules, which is why they share this chunker."""
    BLOCK = {"p", "br", "li", "hr", "ul", "ol", "dl", "dt", "dd", "tr", "table",
             "div", "blockquote"}
    HEAD = {"h1", "h2", "h3", "h4"}

    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.title, self.sections = "", [[None, []]]
        self._in_title = self._in_head = self._skip = False
        self._pre = 0
        self._cur = None          # heading text being collected

    def handle_starttag(self, tag, attrs):
        if tag == "title":
            self._in_title = True
        elif tag in ("script", "style"):
            self._skip = True
        elif tag in self.HEAD:
            self._in_head, self._cur = True, []
        elif tag == "pre":
            self._pre += 1
            self.sections[-1][1].append("\n")
        elif tag in self.BLOCK:
            self.sections[-1][1].append("\n\n" if tag == "p" else "\n")

    def handle_endtag(self, tag):
        if tag == "title":
            self._in_title = False
        elif tag in ("script", "style"):
            self._skip = False
        elif tag in self.HEAD and self._in_head:
            self._in_head = False
            self.sections.append([" ".join("".join(self._cur).split()), []])
        elif tag == "pre":
            self._pre = max(0, self._pre - 1)
            self.sections[-1][1].append("\n")
        elif tag in self.BLOCK:
            self.sections[-1][1].append("\n")

    def handle_data(self, data):
        if self._skip:
            return
        if self._in_title:
            self.title += data
        elif self._in_head:
            self._cur.append(data)
        else:
            self.sections[-1][1].append(
                data if self._pre
                else " ".join(data.split()) + " " if data.strip() else " ")


_NAV = re.compile(r"(?m)^\s*(?:\[[^\]\n]{1,40}\]\s*){1,6}$\n?")   # [prev][next][TOC]


def chunk_html(text):
    """One HTML page -> (heading, body) sections; see _HtmlText."""
    p = _HtmlText()
    try:
        p.feed(text)
        p.close()
    except Exception:            # a truncated or non-HTML file still yields text
        pass
    title = " ".join(p.title.split())
    out = []
    for heading, parts in p.sections:
        body = _NAV.sub("", "".join(parts))
        body = re.sub(r"[ \t]+\n", "\n", body)
        body = re.sub(r"\n{3,}", "\n\n", body).strip()
        if not body:
            continue
        # the book-name <h2> and the <title> repeat on every page; neither is
        # an article title, so a section headed by them keeps the page <title>
        out.append((heading if heading and heading != title else title or None, body))
    return _postprocess(out)


CHUNKERS = {"inf": chunk_inf, "md": chunk_md, "redbook": chunk_redbook,
            "source": chunk_source, "html": chunk_html}


# ------------------------------------------------- what the library offers

# Extension -> chunker kind. A `.txt` file is decided by looking INSIDE it (see
# _sniff_text): inf2txt output carries its own section markers, and chunking it
# as flat book text would throw away the one structure this material has.
# Anything not listed is skipped -- images, archives, .map/.json and the rest
# are not prose and would only dilute the index.
_EXT_KIND = {
    ".htm": "html", ".html": "html",
    ".md": "md",
    ".txt": None,          # sniffed
    ".h": "source", ".hpp": "source", ".inc": "source", ".c": "source",
    ".cpp": "source", ".asm": "source", ".def": "source", ".idl": "source",
    ".rc": "source", ".dlg": "source", ".cmd": "source", ".rex": "source",
}

_INF_MARK = re.compile(r"(?m)^=== .+ ===$")


def _sniff_text(path):
    """`inf` when the file carries inf2txt's own section markers, else
    `redbook` -- whose chunker falls back to fixed windows, so it is the safe
    default for prose with no structure to find."""
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            head = f.read(65536)
    except OSError:
        return None
    return "inf" if _INF_MARK.search(head) else "redbook"


def _load_os2lib():
    try:
        import os2lib
    except ImportError as e:
        die(f"cannot import os2lib ({e}).\n"
            f"       `know ingest` with no PATH reads the OS/2 library, and\n"
            f"       tools/os2lib.py must sit beside this tool. Pass explicit\n"
            f"       paths to ingest without it.")
    return os2lib


def _item_roots(os2lib, it):
    """(path, dir?) roots of one item, agreeing with what `os2-lib grep` reads.

    Uses os2lib's own resolver when it is available so the two tools never
    disagree about what an item contains; the fallback below is the same rule
    stated coarsely (derived text/ and tree/, plus the original for link,
    convert and import modes), minus the part_of exclusion."""
    fn = getattr(os2lib, "_search_roots", None)
    if fn is not None:
        return [p for p, _filtered in fn(it)]
    roots = []
    mode = it.get("search", "both")
    if mode in ("text", "both"):
        for sub in ("text", "tree"):
            p = os.path.join(it.dir, sub)
            if os.path.isdir(p):
                roots.append(p)
    if mode in ("original", "both") and it.get("mode") in ("link", "convert", "import"):
        o = it.original()
        if o and os.path.exists(o):
            roots.append(o)
    return roots


def library_sources(category=None, role_name=None, slug=None, want_kind=None):
    """[(path, kind, item)] for everything in the library worth indexing.

    THE MAPPING, and it is stated here rather than guessed per file:
      * every item's derived `text/` and extracted `tree/`, and the original it
        links to, are candidates -- the same roots `os2-lib grep` searches, so a
        question answered by one is answerable by the other;
      * items whose kind is not text at all (binaries, disc and VM images,
        dumps, installed system trees, toolchains) are skipped, because indexing
        them buys nothing and costs the whole index's precision;
      * each candidate FILE gets its chunker from its extension -- headers and
        source trees become kind `source`, HTML books and article mirrors become
        `html`, markdown becomes `md`, and a `.txt` is read to decide whether it
        is converted INF text or flat book text.

    Nothing here invents a path: every root comes from an item's own ITEM.md.
    """
    os2lib = _load_os2lib()
    root = os2lib.library_root()
    if not os.path.isdir(root):
        die(f"no OS/2 library at {root}\n"
            f"       Nothing to ingest, and this tool will not go looking for\n"
            f"       material elsewhere on the disk. Tell Claude what OS/2\n"
            f"       material you have and where; the os2-toolkit:ingest skill\n"
            f"       files it into the library (PATHS.md), and `os2-lib init`\n"
            f"       creates the library itself.")
    opaque = getattr(os2lib, "OPAQUE_KINDS", set())
    items, broken = [], []
    for it in os2lib.iter_items(root=root, category=category):
        if it.error:
            broken.append(f"{it.slug} ({it.error})")
            continue
        if slug and it.slug != slug:
            continue
        if role_name and role_name not in it.provides:
            continue
        if not role_name and it.get("kind") in opaque:
            continue
        items.append(it)
    if not items:
        what = ", ".join(x for x in (
            f"category {category}" if category else "",
            f"role {role_name}" if role_name else "",
            f"item {slug}" if slug else "") if x) or "any text material"
        die(f"the OS/2 library at {root} offers nothing matching: {what}\n"
            + (f"       (unreadable ITEM.md: {'; '.join(broken)})\n" if broken else "")
            + f"       `os2-lib ls` lists what is there and `os2-lib roles` what\n"
            f"       it provides. To add material, tell Claude where it is --\n"
            f"       the os2-toolkit:ingest skill files it (PATHS.md).")
    out, seen, unusable = [], set(), []
    for it in items:
        roots = _item_roots(os2lib, it)
        if not roots:
            why = ("original missing" if not it.available()
                   else "no text/ or tree/ -- not converted yet")
            unusable.append(f"{it.slug} ({why})")
            continue
        n0 = len(out)
        # ITEM.md may narrow what is worth indexing from this item. An RE corpus
        # is the case that forces it: its write-ups are the knowledge, while its
        # hundred thousand decompiled .c files are one interpretation of bytes,
        # and indexing them would rank a guess beside IBM's own words.
        spec = it.get("ingest")
        allow = None
        if spec is not None:
            allow = {k.strip() for k in str(spec).split(",") if k.strip()}
            if allow == {"none"}:
                unusable.append(f"{it.slug} (ingest: none)")
                continue
        for r in roots:
            for path in _walk_text(r):
                rp = os.path.realpath(path)
                if rp in seen:
                    continue            # one file, one chunk set, whichever
                seen.add(rp)            # item reaches it first
                kind = _EXT_KIND.get(os.path.splitext(path)[1].lower(), "?")
                if kind == "?":
                    continue
                if kind is None:
                    kind = _sniff_text(path)
                if kind is None or (want_kind and kind != want_kind):
                    continue
                if allow is not None and kind not in allow:
                    continue            # ITEM.md `ingest:` narrowed this item
                out.append((path, kind, it))
        if len(out) == n0:
            unusable.append(f"{it.slug} (no indexable files under its roots)")
    if not out:
        die("the OS/2 library holds items, but none of them offers text this "
            "tool can index.\n"
            + (f"       skipped: {'; '.join(unusable)}\n" if unusable else "")
            + "       Material that is not greppable as it stands (INF, PDF, an\n"
              "       archive) needs converting first: `os2-lib convert <slug>`,\n"
              "       or ask Claude to run the os2-toolkit:ingest skill.")
    if unusable:
        print("note: skipped " + "; ".join(unusable), file=sys.stderr)
    return out


def _walk_text(root):
    if os.path.isfile(root):
        yield root
        return
    for base, dirs, files in os.walk(root, followlinks=True):
        dirs[:] = [d for d in sorted(dirs) if not d.startswith(".")]
        for f in sorted(files):
            if os.path.splitext(f)[1].lower() in _EXT_KIND:
                yield os.path.join(base, f)


# -------------------------------------------------------------- staleness

def stale_paths(conn):
    """(changed, missing) source files. A chunk whose file no longer contains
    its text is the worst thing a CITATION store can do, so this is checked
    rather than hoped for.

    Cheap first: stat() every distinct path and hash only the ones whose size or
    mtime moved -- an mtime that moved with identical content (a touch, a
    re-extraction, a restored backup) is NOT stale, and re-hashing settles it."""
    changed, missing, restamp = [], [], []
    rows = conn.execute("SELECT path, corpus, sha, size, mtime, COUNT(*) n "
                        "FROM chunk GROUP BY path").fetchall()
    for r in rows:
        try:
            st = os.stat(r["path"])
        except OSError:
            missing.append((r["path"], r["corpus"], r["n"]))
            continue
        if r["size"] is not None and r["mtime"] is not None \
           and int(st.st_size) == r["size"] and int(st.st_mtime) == r["mtime"]:
            continue                               # unchanged, no hash needed
        try:
            text = open(r["path"], encoding="utf-8", errors="replace").read()
        except OSError:
            missing.append((r["path"], r["corpus"], r["n"]))
            continue
        if hashlib.sha256(text.encode()).hexdigest()[:16] != r["sha"]:
            changed.append((r["path"], r["corpus"], r["n"]))
        else:
            restamp.append((int(st.st_size), int(st.st_mtime), r["path"]))
    # ONE commit for the whole pass. An earlier version committed PER FILE, and
    # on a store whose paths had all been re-stamped that meant thousands of
    # fsync'd commits behind a single `know q`: measured at over two minutes,
    # against 0.35 s with the staleness check skipped. A killed run kept only
    # the rows already committed, so each attempt healed a fraction and the
    # "~60 ms" claim held for nobody until one pass ran to completion.
    if restamp:
        conn.executemany("UPDATE chunk SET size=?, mtime=? WHERE path=?", restamp)
        conn.commit()
    return changed, missing


def stale_set(conn):
    """Paths whose chunks must not be trusted (changed only -- a MISSING file is
    usually an unmounted disk holding part of the library, not a wrong
    answer)."""
    changed, _ = stale_paths(conn)
    return {p for p, _, _ in changed}


# --------------------------------------------------------------- retrieval

def fts_query(q):
    toks = [t for t in re.findall(r"[A-Za-z0-9_$#.]+", q) if len(t) > 1]
    return " OR ".join(f'"{t}"' for t in toks)


FACT_CAP = 3

# Function and question words only. Domain verbs a query legitimately shares
# with a subject (read, write, set, open, lock, wait) are deliberately NOT here.
_SUBJECT_STOP = frozenset("""
a an the and or not no nor but of to in on at by for from with as into onto
than then there their them they this that these those it its is are was were
be been being do does did done has have had having can could should would will
may might must shall how what which when where who whom whose why whether if
so up out about over under between through during before after above below
one two any all some each every both either neither such same other another
own very just also only ever never we you i he she me my our your his her
""".split())


def _subject_query(q):
    """The FTS5 query used to decide whether a fact is ABOUT the question: the
    question's tokens minus stopwords and 1-2 letter fragments, ORed. Empty when
    nothing distinctive is left, and then nothing is promoted."""
    toks = [t for t in re.findall(r"[A-Za-z0-9_$#.]+", q)
            if len(t) > 2 and t.lower() not in _SUBJECT_STOP]
    return " OR ".join(f'"{t}"' for t in toks)


def search(conn, query, limit=20, corpus=None, component=None, facts_only=False):
    fq = fts_query(query)
    if not fq:
        return []
    hits = []
    sql = ("SELECT f.id, f.subject, f.claim, f.citation, f.provenance, f.kind, "
           "f.corroboration, f.superseded_by, bm25(fact_fts, 5.0, 1.0) r FROM fact_fts "
           "JOIN fact f ON f.id = fact_fts.rowid WHERE fact_fts MATCH ?")
    p = [fq]
    if component:
        sql += " AND f.component = ?"
        p.append(component)
    sql += " ORDER BY r LIMIT ?"
    p.append(limit)
    for r in conn.execute(sql, p):
        hits.append({"what": "fact", "id": r["id"], "score": -r["r"],
                     "title": r["subject"], "text": r["claim"],
                     "cite": r["citation"], "prov": r["provenance"],
                     "corrob": r["corroboration"],
                     "superseded_by": r["superseded_by"]})
    if not facts_only:
        sql = ("SELECT c.id, c.path, c.heading, c.body, bm25(chunk_fts, 5.0, 1.0) r "
               "FROM chunk_fts JOIN chunk c ON c.id = chunk_fts.rowid "
               "WHERE chunk_fts MATCH ?")
        p = [fq]
        if corpus:
            sql += " AND c.corpus = ?"
            p.append(corpus)
        sql += " ORDER BY r LIMIT ?"
        p.append(limit)
        for r in conn.execute(sql, p):
            hits.append({"what": "chunk", "id": r["id"], "score": -r["r"],
                         "title": r["heading"] or "", "text": r["body"],
                         "cite": r["path"], "prov": None, "corrob": None,
                         "superseded_by": None})
    # RANKING. bm25 scores from two FTS indexes over two corpora are NOT on a
    # comparable scale, so they are never blended. A curated fact is promoted
    # above the material only when the query matched its SUBJECT - i.e. the
    # query is about the thing the fact is about. Everything else is ordered
    # within its own group, facts last.
    #
    # Two weaker rules were tried and MEASURED against a 56-question answer set,
    # and both degrade as the curated set grows, which is the worst possible
    # shape for a store meant to accumulate:
    #   * facts first, unconditionally  -> recall@1 22/56 -> 6/56 with TWO facts
    #     in the store, both matching many queries weakly on a common word;
    #   * min-max normalise each group  -> 19/56, because normalising a
    #     two-element group forces its best member to 1.0 regardless of how
    #     weakly it actually matched.
    # The subject test was then tuned at TWO facts, and at 96 it failed the same
    # way: `fts_query` ORing every token of the question -- "how", "the", "from"
    # -- against subjects that are often whole sentences made 55 of 56 questions
    # "match" a median of 17 fact subjects, so the top seventeen slots were facts
    # and recall@1 read 0/56 with facts present against 16/56 without. Two
    # changes, neither tuned to the answer set:
    #   1. the SUBJECT test ignores stopwords and 1-2 letter tokens -- a fact is
    #      about the query's NOUNS, not its grammar;
    #   2. at most FACT_CAP facts sit above the material, best first; the rest go
    #      after it. A store meant to accumulate must not be able to push the
    #      material off the page by growing.
    strong = set()
    sq = _subject_query(query)
    if sq:
        try:
            for r in conn.execute(
                    "SELECT rowid FROM fact_fts WHERE fact_fts MATCH ? LIMIT ?",
                    ("subject : (" + sq + ")", limit)):
                strong.add(r["rowid"])
        except sqlite3.OperationalError:
            pass                      # a column filter is a nicety, not a gate
    promoted = sorted((h for h in hits if h["what"] == "fact" and h["id"] in strong),
                      key=lambda h: -h["score"])[:FACT_CAP]
    top = {h["id"] for h in promoted}

    def key(h):
        if h["what"] == "fact":
            return (0 if h["id"] in top else 2, -h["score"])
        return (1, -h["score"])
    hits.sort(key=key)
    return hits[:limit]


