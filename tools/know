def cmd_supersede(a):
    """A correction is a data structure, for facts AND for negatives.

    ONE TABLE PER CALL, refused loudly across the two. `fact.superseded_by`
    REFERENCES fact(id) and `search.superseded_by` REFERENCES search(id), so a
    cross-table link is not a debatable modelling choice -- it is an id pointing
    into the wrong table, and it would read back as a valid row.
    """
    c = connect()
    t_old, old = parse_row_id(a.old)
    t_by, by = parse_row_id(a.by)
    if t_old != t_by:
        die(f"{fmt_row_id(t_old, old)} and {fmt_row_id(t_by, by)} are in "
            f"different tables\n"
            f"       superseded_by points WITHIN a table; a cross-table id "
            f"would silently name an unrelated row.\n"
            f"       If a negative turned out to be wrong because the thing IS "
            f"there, record the finding\n"
            f"       with `know add`, then retract the negative with a "
            f"corrected `know absent` and supersede it by THAT.")
    if old == by:
        die(f"{fmt_row_id(t_old, old)} cannot supersede itself")
    for i in (old, by):
        if not c.execute(f"SELECT 1 FROM {t_old} WHERE id=?", (i,)).fetchone():
            die(f"no {fmt_row_id(t_old, i)}", 1)
    cur = c.execute(f"SELECT superseded_by FROM {t_old} WHERE id=?",
                    (old,)).fetchone()["superseded_by"]
    if cur is not None:
        die(f"{fmt_row_id(t_old, old)} is already superseded by "
            f"{fmt_row_id(t_old, cur)}\n"
            f"       Re-pointing it would rewrite the churn ledger this verb "
            f"exists to keep. A correction OF\n"
            f"       a correction EXTENDS the chain instead: supersede "
            f"{fmt_row_id(t_old, cur)}, the current tip, by the new row.")
    # A cycle would drop BOTH rows out of `verify`'s sweep -- two rows silently
    # unmeasured, reported by nothing, which is the exact failure this whole
    # instrument exists to prevent. Walk the chain from `by` first.
    seen, cursor = {by}, by
    while True:
        nxt = c.execute(f"SELECT superseded_by FROM {t_old} WHERE id=?",
                        (cursor,)).fetchone()["superseded_by"]
        if nxt is None:
            break
        if nxt == old or nxt in seen:
            die(f"that would make a supersede CYCLE through "
                f"{fmt_row_id(t_old, nxt)}\n"
                f"       Every row in a cycle is superseded, so every row in it "
                f"drops out of `verify`\n"
                f"       and nothing reports that it did.")
        seen.add(nxt)
        cursor = nxt
    c.execute(f"UPDATE {t_old} SET superseded_by=? WHERE id=?", (by, old))
    # The audit row records WHICH table, and does NOT put a search id in fact_id
    # (that column REFERENCES fact). fact_id is set only for a fact.
    c.execute("INSERT INTO search(question,tier,target,verdict,result,fact_id,ts) "
              "VALUES (?,?,?,?,?,?,?)",
              (f"supersede {fmt_row_id(t_old, old)} by {fmt_row_id(t_by, by)}",
               "other", f"{t_old}#{old}", "hit", a.message,
               by if t_old == "fact" else None, int(time.time())))
    c.commit()
    print(f"{fmt_row_id(t_old, old)} superseded by {fmt_row_id(t_by, by)} -- "
          f"the old row is KEPT as the churn\nledger, with its text and its "
          f"verify command, and is returned beside its correction.")
    if t_old == "search":
        print("It drops out of `know verify --all` from now on; `know show "
              f"{fmt_row_id(t_old, old)}` still reads it in full.")


def cmd_promote(a):
    """Raise (or correct) a fact's provenance. Deliberately NOT automatable:
    promoting an inference to an observation is how a re-derivation becomes a
    wrong re-derivation, and it is a judgement, not a command exit code.

    The original citation is APPENDED TO, never replaced. An earlier version
    wrote --evidence over `citation` and the prior file:line was unrecoverable
    even from the audit row -- in the one verb nominated as the human gate, under
    a schema comment saying citation is NOT NULL "deliberately: a fact without a
    checkable citation is a memory".

    And a corroboration change requires a NEW --verify: the old command
    establishes the OLD basis, so leaving it in place makes `verify --all` report
    AGREE about evidence that is no longer the citation."""
    if os.environ.get("KNOW_AGENT"):
        die("promote is refused while KNOW_AGENT is set.\n"
            "       Raising a provenance tag is a human or graded-review act.\n"
            "       Automation records a PROPOSAL with `know add --prov INF`\n"
            "       and leaves the tag alone.")
    c = connect()
    r = c.execute("SELECT provenance, corroboration, subject, citation, "
                  "verify_cmd, verify_cmd2 FROM fact WHERE id=?", (a.id,)).fetchone()
    if not r:
        die(f"no fact #{a.id}", 1)
    v1 = a.verify if a.verify is not None else r["verify_cmd"]
    v2 = a.verify2 if a.verify2 is not None else r["verify_cmd2"]
    if a.corrob != r["corroboration"] and a.verify is None:
        die(f"corroboration is changing '{r['corroboration']}' -> '{a.corrob}' "
            f"but no --verify was given.\n"
            f"       The stored command establishes the OLD basis, so leaving it\n"
            f"       makes `verify --all` report AGREE about evidence that is no\n"
            f"       longer the citation. Give the command that checks the NEW\n"
            f"       basis (or pass --verify '' to record that none exists).")
    check_tag(a.prov, a.corrob, v1 or None, v2 or None)
    stamp = time.strftime("%Y-%m-%d", time.localtime())
    citation = (f"{r['citation']}\n  + promoted {stamp} "
                f"[{r['provenance']}/{r['corroboration']}] -> "
                f"[{a.prov}/{a.corrob}] by {a.by}: {a.evidence}")
    # EVERY field this UPDATE overwrites goes into the audit row first. One
    # version overwrote `citation` and kept nothing; its own fix then overwrote
    # `verify_cmd`/`verify_cmd2` instead, keeping nothing -- the same defect one
    # field over, in the same function, introduced by the fix for the first. The
    # rule that generalises: a verb whose whole job is to record a transition
    # must record what it DISPLACED, not merely what replaced it.
    prior = [f"prior citation: {r['citation']}"]
    if v1 != r["verify_cmd"]:
        prior.append(f"prior verify_cmd: {r['verify_cmd'] or '(none)'}")
    if v2 != r["verify_cmd2"]:
        prior.append(f"prior verify_cmd2: {r['verify_cmd2'] or '(none)'}")
    c.execute("UPDATE fact SET provenance=?, corroboration=?, citation=?, "
              "verify_cmd=?, verify_cmd2=? WHERE id=?",
              (a.prov, a.corrob, citation, v1 or None, v2 or None, a.id))
    c.execute("INSERT INTO search(question,tier,target,verdict,result,fact_id,ts) "
              "VALUES (?,?,?,?,?,?,?)",
              (f"promote #{a.id}", "other", f"fact#{a.id}", "hit",
               f"[{r['provenance']}/{r['corroboration']}] -> [{a.prov}/{a.corrob}] "
               f"by {a.by}: {a.evidence}  (" + "; ".join(prior) + ")",
               a.id, int(time.time())))
    c.commit()
    print(f"#{a.id} {r['subject']}: [{r['provenance']}/{r['corroboration']}] "
          f"-> [{a.prov}/{a.corrob}]  authorised by {a.by}")
    print("  prior state kept in the audit row: " + ", ".join(
        x.split(":")[0] for x in prior))


