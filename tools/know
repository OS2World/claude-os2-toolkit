# Words too common to distinguish one recorded search from another.
_SEARCH_STOP = {"the", "and", "for", "are", "was", "does", "did", "what", "when",
                "where", "which", "with", "that", "this", "from", "have", "has",
                "how", "why", "its", "it's", "not", "any", "all", "can", "use",
                "used", "into", "onto", "under", "over", "only", "own",
                "documented", "document", "documentation", "about", "real",
                "book", "books"}


def prior_searches(c, query, limit=5):
    """Recorded searches relevant to `query`, ranked by shared distinctive terms.

    WHY NOT `question LIKE '%<query>%'`, which is what this was until the wiring
    was tested end to end: that requires the STORED question to contain the typed
    one verbatim, so you had to already know the recorded wording to find it.
    Asking "is FSH_CALLDRIVER documented in the IBM books" surfaced nothing while
    the store held "...in the IBM INF books" -- one word apart. That made the
    negative-result feature, which is the ONLY thing this store does that a grep
    cannot, effectively unreachable, and it was invisible until a live run.

    Term overlap rather than FTS because `search` has no FTS index and adding one
    is a schema migration with export and round-trip consequences for a table
    that holds a handful of rows. Revisit if it grows: the ranking below is
    linear in the table."""
    terms = {t for t in re.findall(r"[A-Za-z_][A-Za-z0-9_]{2,}", query.lower())
             if t not in _SEARCH_STOP}
    if not terms:
        return []
    rows = c.execute("SELECT id,tier,target,verdict,result,question,ts,"
                     "superseded_by FROM search").fetchall()
    scored = []
    for r in rows:
        hay = f"{r['question']} {r['result'] or ''}".lower()
        n = sum(1 for t in terms if t in hay)
        if n:
            scored.append((n, r["ts"], r))
    scored.sort(key=lambda x: (-x[0], -x[1]))
    return [r for _, _, r in scored[:limit]]


def cmd_q(a):
    c = connect()
    stale = set() if a.no_stale_check else stale_set(c)
    if stale:
        print(f"!! {len(stale)} source file(s) CHANGED since ingest -- hits from "
              f"them are marked [STALE]\n!! and may quote text the file no longer "
              f"contains. Fix with: know refresh\n")
    hits = search(c, a.query, limit=a.limit, corpus=a.corpus,
                  component=a.component, facts_only=a.facts)
    prior = prior_searches(c, a.query)
    if prior:
        print("ALREADY SEARCHED -- read this before searching anything else:")
        for r in prior:
            # A RETRACTED negative is still shown, and shown FIRST-CLASS -- the
            # same treatment a superseded fact gets. Hiding it would delete the
            # trap (a `grep -c` verify that COUNTS instead of finding nothing)
            # that the row exists to teach.
            sup = (f"   ** SUPERSEDED BY neg#{r['superseded_by']} -- read that "
                   f"first **" if r["superseded_by"] else "")
            print(f"  neg#{r['id']} {r['verdict']:<7} {r['tier']:<15} "
                  f"\"{r['question']}\"{sup}")
            print(f"          {r['target']}"
                  + (f"\n          {r['result']}" if r["result"] else ""))
        print("  (`know log` for the full transcript; an 'absent' row means "
              "someone already\n   looked and did not find it -- re-running "
              "their search costs you and proves\n   nothing new unless you "
              "widen it.)\n")
    if not hits:
        print("no hits. That is NOT a finding until you have also grepped: this "
              "store holds\nonly what has been ingested (know stats), and "
              "`os2-lib grep` reads the rest.")
        return
    shown_fact = shown_chunk = False
    for h in hits:
        if h["what"] == "fact":
            if not shown_fact:
                print("-- derived facts (curated, with citations) --")
                shown_fact = True
            tag = f"fact #{h['id']} [{h['prov']}/{h['corrob']}]"
            sup = ""
            if h["superseded_by"]:
                sup = f"  ** SUPERSEDED BY #{h['superseded_by']} -- read that first **"
            print(f"\n{tag} {h['title']}{sup}\n  {h['text']}\n  cite: {h['cite']}")
        else:
            if not shown_chunk:
                print("\n-- material, best first --")
                shown_chunk = True
            body = h["text"] if a.full else h["text"][:400].replace("\n", " ")
            mark = " [STALE]" if h["cite"] in stale else ""
            print(f"\n{h['cite']}{mark}  sec. {h['title'][:70]}\n  {body}")


_ROW_ID = re.compile(r"^(neg)?#?(\d+)$", re.I)


def parse_row_id(tok):
    """'12' / '#12' -> ('fact', 12);  'neg7' / 'neg#7' -> ('search', 7).

    TWO id spaces, spelled the way the tool already PRINTS them: `verify`
    reports a fact as `#12` and a search row as `neg#7`, so the id a reader has
    in hand is the id these verbs accept. Until this existed `supersede` was
    `type=int` on both arguments and `supersede neg7 neg8` died with `invalid int
    value: 'neg7'` -- so the negative half of the store had no correction path at
    all.

    `neg#` is the SEARCH table's spelling, not the `absent`-verdict's: every row
    in that table shares one id space, and inventing a second prefix for `hit`
    rows would make the id you read in one place unusable in another.
    """
    m = _ROW_ID.match(tok.strip())
    if not m:
        die(f"not a row id: {tok!r}\n"
            f"       facts are `12` or `#12`; search/negative rows are "
            f"`neg7` or `neg#7`, exactly as `know verify --all` prints them")
    return ("search" if m.group(1) else "fact"), int(m.group(2))


def fmt_row_id(table, i):
    return f"neg#{i}" if table == "search" else f"#{i}"


def cmd_show(a):
    c = connect()
    table, rid = parse_row_id(a.id)
    r = c.execute(f"SELECT * FROM {table} WHERE id=?", (rid,)).fetchone()
    if not r:
        die(f"no {fmt_row_id(table, rid)}", 1)
    for k in r.keys():
        if r[k] not in (None, ""):
            print(f"{k:<14} {r[k]}")
    # Both directions of the chain, for BOTH tables. A superseded negative that
    # could only be read back through `export` would be text kept where nobody
    # looks.
    if r["superseded_by"]:
        print(f"{'SUPERSEDED BY':<14} {fmt_row_id(table, r['superseded_by'])}"
              f"  -- read that first")
    kids = c.execute(f"SELECT id FROM {table} WHERE superseded_by=?",
                     (rid,)).fetchall()
    if kids:
        print(f"supersedes     "
              f"{', '.join(fmt_row_id(table, k['id']) for k in kids)}")


