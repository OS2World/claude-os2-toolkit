def check_tag(prov, corrob, verify=None, verify2=None):
    """Hard-refuse only the circular case; warn on anything else unusual."""
    if corrob == "self" and prov in TAG_FORBIDS_SELF:
        die(f"[{prov}] cannot rest on corroboration 'self'.\n"
            f"       'self' means: {CORROB_MEANS['self']}\n"
            f"       Citing one of our own notes and verifying by grepping that\n"
            f"       same file establishes nothing -- our notes are the SUBJECT\n"
            f"       of verification, never the authority.\n"
            f"       Cite IBM text, a binary, or a capture -- or use [INF]/[OBS].")
    if corrob == "two-source" and not (verify and verify2):
        die("corroboration 'two-source' needs BOTH --verify and --verify2.\n"
            "       It is the strongest tier; an unverifiable strongest tier is\n"
            "       decoration, and this store's whole argument is that it is\n"
            "       not a memory. Give the command that reads the BYTES and the\n"
            "       one that reads the DOC.")
    if corrob not in TAG_EXPECTS[prov]:
        print(f"note: [{prov}] with corroboration '{corrob}' is unusual.\n"
              f"      '{corrob}' means: {CORROB_MEANS[corrob]}\n"
              f"      [{prov}] usually rests on: "
              f"{', '.join(sorted(TAG_EXPECTS[prov]))}\n"
              f"      Recorded as given. If this is load-bearing, re-derive it\n"
              f"      from a primary source before anything lands on it."
              + ("\n      (A KERNEL-DEBUGGER reading is legitimately "
                 "[OBS-RE]+measured;\n       a probe result on real OS/2 is "
                 "[OBS]. The tool cannot tell\n       them apart -- you can.)"
                 if prov == "OBS-RE" and corrob == "measured" else ""),
              file=sys.stderr)


# ------------------------------------------------------------ citation rules
#
# A FACT here is about OS/2, and its citation has to name something the next
# reader can open. That is the whole difference between knowledge and a memory:
# an unsourced value is dangerous because it is UNFALSIFIABLE -- you can re-read
# a header and re-run a probe, but you cannot re-run anyone's recollection.
#
# So a citation must name ONE of four things, and the shapes below are what the
# tool recognises:
#
#   1. LIBRARY MATERIAL, by role or by item -- `os2-lib role toolkit-headers
#      headers`, `docs/ibm-os2-toolkit-4.5-books/text/pm2.txt`. A role survives
#      the material moving; a machine path does not.
#   2. AN IBM BOOK PLUS A TOPIC -- pm2.txt "WinLoadString - Syntax". The book
#      alone is not a citation: these books are thousands of panels, and "it is
#      in pm2" is not something a reader can check.
#   3. A file:line IN HEADERS OR SOURCE -- bsedos.h:2616, kbdscan.asm:114.
#   4. A BINARY AND AN OFFSET, for anything read out of one -- PMMERGE.DLL
#      obj3+0x1e8c. Per-build by nature, which is what the `build` column is
#      for.
#
# What is REFUSED, loudly: a citation pointing into a project's own source tree.
# Your code is the SUBJECT being validated, never the authority for what OS/2
# does, and a row keyed to a tree that changes every day is stale on arrival.
# Note the character class excludes DIGITS as well as letters and `/`: with
# `[^A-Za-z/]` a path like `~/os2docs/inf_text` matched, because the `2` before
# `docs/` counted as a boundary.
_PROJECT_CITE = re.compile(
    r"(^|[^A-Za-z0-9/])(src|lib|tests?|build|obj|include)/")

# A citation says what establishes the fact AND, often, how it was read:
#   "DOSCALL1.DLL obj4+0x0fd4 (retf 4, read with lx_disasm.py)"
# The parenthesis is method, not source, and the rule is explicitly that how you
# re-read a source is not the source -- so parenthesised spans are dropped
# before matching, in both directions.
_PARENS = re.compile(r"\([^()]*\)")

_CITE_OK = (
    # a role, or an item path/slug under a library category
    re.compile(r"\bos2-lib\s+(role|path)\b"),
    re.compile(r"(^|[^A-Za-z0-9/])(docs|source|examples|re|media|toolchains|notes)/"
               r"[a-z0-9][a-z0-9.\-]*"),
    # file:line in a header, source file, book text or reference doc
    re.compile(r"[\w.+-]+\.(h|hpp|inc|c|cpp|asm|def|idl|rc|dlg|txt|md|htm|html)"
               r"\s*:\s*\d+", re.I),
    # a book (or page) plus a named topic
    re.compile(r"[\w.+-]+\.(txt|htm|html|inf)\b[^\n]*[\"'][^\"']{3,}[\"']", re.I),
    re.compile(r"[\w.+-]+\.(txt|htm|html|inf)\b\s*(sec\.|section|topic|panel)\s+\S",
               re.I),
    # a shipped binary and an offset
    re.compile(r"[\w.+-]+\.(dll|exe|sys|drv|ifs|add|flt|dmd|snp)\b[^\n]*"
               r"(obj\s*\d+|\+\s*0x[0-9a-f]+|0x[0-9a-f]{4,})", re.I),
    # an ordinal in a named module
    re.compile(r"[\w.+-]+\.(dll|exe|sys)\s*#\s*\d+", re.I),
)

_CITE_HELP = (
    "       A citation must name something the next reader can OPEN:\n"
    "         * library material by role or item path --\n"
    "           `os2-lib role toolkit-headers headers`, or\n"
    "           docs/<item-slug>/text/<book>.txt\n"
    "         * an IBM book AND a topic -- pm2.txt \"WinLoadString - Syntax\"\n"
    "           (the book alone is not checkable; these are thousands of panels)\n"
    "         * a file:line in headers or source -- bsedos.h:2616\n"
    "         * a binary and an offset -- PMMERGE.DLL obj3+0x1e8c\n"
    "       How you re-read a source is not the source: a tool invocation in\n"
    "       parentheses is fine, and so is a verify_cmd that runs one.")


def _reject_bad_citation(a):
    """A fact without a checkable citation is a memory, not knowledge.

    Two refusals, both loud. `--corrob self` on a FACT: `self` is defined by
    this tool's own help as "our own notes or code -- a pointer, not knowledge",
    which is the reliable tell for a row that is about us rather than about
    OS/2. It stays correct for a SEARCH: recording where WE looked is our state
    by nature, which is what the search table is for."""
    if a.corrob == "self":
        die("a FACT may not be corroborated by `self`.\n"
            "       `self` means our own notes or code -- a pointer, not knowledge.\n"
            "       A fact here is about OS/2: IBM documentation, RE of a shipped\n"
            "       binary, or a measurement on a real machine. What your own code\n"
            "       does belongs in your project's notes; it changes every day and\n"
            "       would need constant updating here.\n"
            "       Use --corrob ibm-doc / bytes / re / measured / two-source.")
    cite = _PARENS.sub(" ", a.cite or "")
    if _PROJECT_CITE.search(cite):
        die(f"the citation points into a PROJECT's own tree, not at a source:\n"
            f"       {a.cite}\n"
            f"       Your code is the SUBJECT being validated, never the authority\n"
            f"       for what OS/2 does, and a row keyed to a tree that changes\n"
            f"       every day is stale on arrival.\n" + _CITE_HELP)
    if not any(rx.search(cite) for rx in _CITE_OK):
        die(f"that citation names nothing checkable:\n"
            f"       {a.cite}\n"
            f"       A fact without a checkable citation is a memory. Recorded as\n"
            f"       given it would look exactly like a sourced one, which is the\n"
            f"       single thing this store cannot absorb.\n" + _CITE_HELP)


def cmd_add(a):
    _reject_bad_citation(a)
    check_tag(a.prov, a.corrob, a.verify, a.verify2)
    c = connect()
    cur = c.execute(
        "INSERT INTO fact(claim,subject,component,kind,provenance,citation,"
        "verify_cmd,verify_cmd2,build,derived_at,derived_by,corroboration) "
        "VALUES (?,?,?,?,?,?,?,?,?,?,?,?)",
        (a.message, a.subject, a.component, a.kind, a.prov, a.cite,
         a.verify, a.verify2, a.build, int(time.time()), a.by, a.corrob))
    c.commit()
    print(f"fact #{cur.lastrowid}  {a.subject}  [{a.prov}/{a.corrob}]  {a.cite}")
    if not a.verify:
        print("  note: no --verify command. `know verify` cannot check this row,\n"
              "        which is what separates a shortcut from a memory.")


