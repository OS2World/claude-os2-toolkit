# SIX values, where the kit's reference corpus ratifies SEVEN tags. That is not
# a drift to reconcile, and reconciling it is the hazard: the seventh is
# `[unverified]`, which marks the ABSENCE of provenance on a CLAIM, inline in
# prose. PROV is the closed set a stored RECORD may carry. Adding `unverified`
# here would create a legal way to store an unverifiable fact - the one thing a
# store that requires a citation and a re-runnable verify command exists to
# prevent. os2ref/README.md explains the split from the other side; this note is
# here because the wrong fix would be made at THIS site.
PROV = ("DOC-IBM", "OBS-RE", "OBS", "OBS-USER", "SRC", "INF", "DOC")
# [SRC] is ratified in os2ref/README.md and was missing here: source read from a
# component that runs ON OS/2 without being OS/2 (kLIBC and the like). It is
# authoritative for what that component does, never for what the platform does.

# WHAT A VERIFICATION ACTUALLY ESTABLISHES. `verify_cmd` alone cannot tell
# knowledge from circularity: a row can cite one of our own documents and
# "verify" by grepping that same file - green forever, establishing nothing.
# Our own notes are the SUBJECT of verification, never the authority. So a row
# records what its command TOUCHED.
CORROB = ("self", "re", "ibm-doc", "bytes", "measured", "two-source")
CORROB_MEANS = {
    "self":       "our own notes or code -- a pointer, not knowledge",
    "re":         "a reverse-engineering write-up -- itself the SUBJECT too",
    "ibm-doc":    "IBM book / DDK / Toolkit text",
    "bytes":      "a shipped IBM binary, read by the command",
    "measured":   "a capture from a running OS/2 machine",
    "two-source": "bytes AND doc agree",
}

# TWO RULES ARE HARD, everything else is advisory. The split exists on two
# reasons:
#   * a tool that refuses legitimate work teaches you to route around it -- a
#     guard that false-positives is worse than none;
#   * provenance answers "how was this ORIGINALLY established" and corroboration
#     answers "how is OUR row checkable now". They are orthogonal, and using the
#     second to veto the first is the error an earlier full matrix made -- a
#     fact established by disassembly has an RE origin even where our own
#     checkability is weak.
#
# HARD RULE 1: a `self`-corroborated row can never be [DOC-IBM] or [OBS-RE].
# That is the genuinely circular case -- cite one of our own documents, "verify"
# by grepping that same document, green forever, establishing nothing.
TAG_FORBIDS_SELF = {"DOC-IBM", "OBS-RE"}

# HARD RULE 2 lives in cmd_promote: no machine raises a tag.

# ADVISORY. An unusual pair is recorded with a warning, never refused: the
# reader sees the corroboration on every hit, which is most of the value.
#
# The mapping mirrors the ratified tag definitions in os2ref/README.md:
# [OBS-RE] is an INTERPRETATION of a binary (re-verified by reading the bytes
# again), [OBS] is a CAPTURE from a running system (re-verified by running the
# probe again). They fail differently, which is the only test a provenance tag
# has to pass.
#
# ONE KNOWN EDGE the tool cannot resolve, so it warns rather than refuses: a
# fact read out of the kernel debugger is [OBS-RE] by the ratified definition,
# but its corroboration is a live capture -- indistinguishable here from a probe
# result. [OBS-RE] + `measured` therefore warns and may still be correct. Read
# the warning, do not silence it.
TAG_EXPECTS = {
    "DOC-IBM": {"ibm-doc", "two-source"},
    "OBS-RE":  {"bytes", "two-source"},          # read out of a binary
    "OBS":     {"measured", "self"},             # a capture, no interpretation
    # Firsthand human observation with NO capture retained. `self` is the honest
    # default -- it cannot be re-run, only corroborated. `measured` is also
    # allowed and is the upgrade path: a probe written later can confirm the
    # recollection without changing what the ORIGINAL observation was, so the
    # tag stays [OBS-USER] while the corroboration strengthens.
    "OBS-USER": {"self", "measured"},
    "SRC":     {"self", "two-source", "measured"},
    "DOC":     {"ibm-doc", "re", "two-source"},
    "INF":     set(CORROB),
}
