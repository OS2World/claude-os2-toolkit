def cmd_export(a):
    """Two artifacts, on purpose:

      facts.md / absent.md  -- readable, reviewable, diffable prose.
      know.jsonl            -- LOSSLESS, and what `import` reads.

    The prose alone is NOT a backup. An earlier version shipped a committed
    sentence saying the store "can be rebuilt from" it while the export silently
    dropped verify_cmd2, derived_at and EVERY negative's verify_cmd -- the last
    being the commands the CONTRADICTED mechanism entirely depends on -- with no
    importer in existence.

    Chunks are deliberately NOT exported: they are re-derivable with `know
    ingest`, and an export carrying book text would be redistributing material
    that is not ours to redistribute.
    """
    import json
    c = connect()
    os.makedirs(a.dir, exist_ok=True)
    fp, ap = os.path.join(a.dir, "facts.md"), os.path.join(a.dir, "absent.md")
    jp = os.path.join(a.dir, "know.jsonl")

    with open(fp, "w", encoding="utf-8") as f:
        f.write("# Knowledge cache - facts\n\n"
                "Generated by `know export`. **Do not edit by hand.** This is the\n"
                "READABLE view; `know.jsonl` beside it is the lossless one and is\n"
                "what `know import` reads. Sorted for a stable diff.\n\n")
        for r in c.execute("SELECT * FROM fact ORDER BY subject, id"):
            sup = (f" - **SUPERSEDED BY #{r['superseded_by']}**"
                   if r["superseded_by"] else "")
            # A markdown code span cannot span lines, and `promote` makes
            # citations multi-line (it appends the transition rather than
            # overwriting). Rendering one inline produced a broken span in the
            # artifact people read and diff.
            cite = r["citation"] or ""
            if "\n" in cite:
                cite_md = "- cite:\n\n  ```\n" + "\n".join(
                    "  " + x for x in cite.splitlines()) + "\n  ```\n"
            else:
                cite_md = f"- cite: `{cite}`\n"
            f.write(f"## #{r['id']} {r['subject']} "
                    f"[{r['provenance']}/{r['corroboration']}]{sup}\n\n"
                    f"{r['claim']}\n\n{cite_md}")
            for k in ("verify_cmd", "verify_cmd2", "build", "component", "kind",
                      "derived_by"):
                if r[k]:
                    f.write(f"- {k}: `{r[k]}`\n")
            if r["derived_at"]:
                f.write("- derived_at: "
                        + time.strftime('%Y-%m-%d', time.localtime(r['derived_at']))
                        + "\n")
            f.write("\n")

    with open(ap, "w", encoding="utf-8") as f:
        f.write("# Knowledge cache - searches, including negative results\n\n"
                "Generated by `know export`. An `absent` row is a FINDING: it\n"
                "closes a question rather than leaving it for the next session to\n"
                "re-derive. Its `verify` command is what `know verify --all`\n"
                "re-runs to catch it going stale.\n\n")
        for r in c.execute("SELECT * FROM search ORDER BY question, ts"):
            # A retracted negative stays in the readable view, MARKED -- the same
            # shape facts.md gives a superseded fact. Its wrong verify command is
            # printed too: that command is the finding.
            sup = (f" - **SUPERSEDED BY neg#{r['superseded_by']}**"
                   if r["superseded_by"] else "")
            f.write(f"- **{r['verdict']}** `{r['tier']}` `{r['target']}`{sup} - "
                    f"{r['question']}"
                    + (f" - {r['result']}" if r["result"] else "") + "\n")
            if r["verify_cmd"]:
                f.write(f"  - verify: `{r['verify_cmd']}`\n")

    n = 0
    with open(jp, "w", encoding="utf-8") as f:
        for table, cols in (("fact", FACT_COLS), ("search", SEARCH_COLS)):
            for r in c.execute(f"SELECT {','.join(cols)} FROM {table} ORDER BY id"):
                f.write(json.dumps({"_t": table, **{k: r[k] for k in cols}},
                                   sort_keys=True, ensure_ascii=False) + "\n")
                n += 1
    print(f"wrote {fp}\nwrote {ap}\nwrote {jp}  ({n} rows, lossless)")


def cmd_import(a):
    """Rebuild fact/search rows from know.jsonl. Chunks are NOT imported -- they
    are re-derivable from the library with `know ingest`."""
    import json
    if a.merge and a.force:
        die("--merge and --force are opposites: one adds the file's rows to the "
            "store, the other replaces the store with them")
    if a.dry_run and not a.merge:
        die("--dry-run is for --merge")
    c = connect(create=True)
    c.executescript(DDL)
    migrate(c)
    if a.merge:
        return _import_merge(c, a, json)
    if c.execute("SELECT COUNT(*) n FROM fact").fetchone()["n"] and not a.force:
        die("store already holds facts; refusing to import over them "
            "(--force to REPLACE them, --merge to add to them)")
    # --force is a RESTORE, not a merge. An earlier version only overwrote rows
    # the export happened to carry, so a row present in the store and absent from
    # the file survived and the result was a union -- which is the one thing a
    # disaster-recovery verb must not produce, because it looks exactly like a
    # successful restore. Clearing first makes the store a copy of the file,
    # which is what "import" is for.
    wiped = None
    if a.force:
        wiped = (c.execute("SELECT COUNT(*) n FROM fact").fetchone()["n"],
                 c.execute("SELECT COUNT(*) n FROM search").fetchone()["n"])
        c.execute("DELETE FROM search")
        c.execute("DELETE FROM fact")
        # NOT printed here: the integrity check below can still roll this back,
        # and a run that says "cleared 2 rows" and then "the store is unchanged"
        # reads as a store in an unknown state. Reported after the commit.
    n = 0
    for line in open(a.path, encoding="utf-8"):
        line = line.strip()
        if not line:
            continue
        row = json.loads(line)
        t = row.pop("_t")
        if t not in ("fact", "search"):
            die(f"unknown row type {t!r} in {a.path}")
        cols = [k for k in row]
        # DELETE then INSERT, never INSERT OR REPLACE. `fact` is the content
        # table of an EXTERNAL-CONTENT FTS5 index: REPLACE's implicit delete does
        # NOT fire the AFTER DELETE trigger (recursive_triggers is off by
        # default) while the AFTER INSERT trigger DOES fire, so the index gains a
        # posting and never loses the old one. The result is silent: a query for
        # a term the row no longer contains still returns it, and plain
        # `integrity-check` passes -- only `integrity-check 1` catches it.
        if row.get("id") is not None:
            c.execute(f"DELETE FROM {t} WHERE id = ?", (row["id"],))
        c.execute(f"INSERT INTO {t}({','.join(cols)}) "
                  f"VALUES ({','.join('?' * len(cols))})",
                  [row[k] for k in cols])
        n += 1
    # Assert it, do not assume it, and assert it BEFORE the commit -- an
    # integrity check that runs after the write has landed can only report the
    # corruption, not prevent it, and this is the disaster-recovery verb. The
    # defect above is invisible to every ordinary query and to plain
    # `integrity-check`.
    try:
        c.execute("INSERT INTO fact_fts(fact_fts, rank) VALUES('integrity-check', 1)")
    except sqlite3.DatabaseError as e:
        c.rollback()
        die(f"import would have left the fact_fts index INCONSISTENT with its "
            f"content table: {e}\n       ROLLED BACK -- the store is unchanged. "
            f"If a store is already in this state, rebuild with:\n"
            f"       sqlite3 <db> \"INSERT INTO fact_fts(fact_fts) VALUES('rebuild')\"")
    c.commit()
    if wiped:
        print(f"--force: cleared {wiped[0]} fact and {wiped[1]} search row(s)")
    print(f"imported {n} rows from {a.path}  (fact_fts integrity verified)")
    print("chunks are NOT included -- re-run `know ingest` for the material")


def _import_merge(c, a, json):
    """--merge: ADD another store's export to this one, under new ids.

    The two stores number their rows independently, so the file's ids collide
    with ours and cannot be kept. Every incoming row gets a fresh id, and the
    three columns that hold ids -- fact.superseded_by, search.superseded_by and
    search.fact_id -- are rewritten through the old->new map, so a supersede
    chain or a search's link to its fact survives the move intact.

    A row that is already here, word for word (a fact's claim AND citation; a
    search's question, target, verdict and result), is not added twice: its id
    maps onto the existing row, so links pointing at it still land.

    What CANNOT be remapped is an id written inside free text -- a claim saying
    "corrects #309" means the SOURCE store's #309. So each merged row records
    where it came from: a fact's derived_by and a search's result gain
    " [merged from LABEL #N]" / " [merged from LABEL neg#N]", and a reader who
    meets "#309" in a merged claim looks for that tag.

    One transaction, integrity-checked before the commit, as the restore is.
    """
    label = a.label or os.path.basename(os.path.dirname(os.path.abspath(a.path))) \
        or os.path.basename(a.path)
    have = {t: {r[1] for r in c.execute(f"PRAGMA table_info({t})")}
            for t in ("fact", "search")}
    rows = {"fact": [], "search": []}
    for ln, line in enumerate(open(a.path, encoding="utf-8"), 1):
        line = line.strip()
        if not line:
            continue
        row = json.loads(line)
        t = row.pop("_t", None)
        if t not in rows:
            die(f"{a.path}:{ln}: unknown row type {t!r}")
        extra = set(row) - have[t]
        if extra:
            # A column this store does not have would be dropped silently by a
            # partial INSERT. Refuse instead: the file comes from a newer or a
            # different schema, and its rows would arrive missing data.
            die(f"{a.path}:{ln}: {t} row has column(s) this store lacks: "
                f"{', '.join(sorted(extra))}")
        rows[t].append(row)

    fmap, smap = {}, {}
    dup_f = dup_s = 0
    added_f, added_s = [], []
    for r in rows["fact"]:
        hit = c.execute("SELECT id FROM fact WHERE claim IS ? AND citation IS ?",
                        (r.get("claim"), r.get("citation"))).fetchone()
        if hit:
            fmap[r["id"]] = hit["id"]
            dup_f += 1
            continue
        old = r.pop("id")
        r["superseded_by"], sup = None, r.get("superseded_by")
        r["derived_by"] = f"{r.get('derived_by') or ''} [merged from {label} #{old}]".strip()
        added_f.append((old, sup, r))
    for r in rows["search"]:
        # `result` is where a merged search records its origin, so a row merged
        # here before carries the tag: match the tagged spelling as well, or a
        # second merge of the same file would add every search again.
        tagged = f"{r.get('result') or ''} [merged from {label} neg#{r['id']}]".strip()
        hit = c.execute("SELECT id FROM search WHERE question IS ? AND target IS ? "
                        "AND verdict IS ? AND (result IS ? OR result IS ?)",
                        (r.get("question"), r.get("target"), r.get("verdict"),
                         r.get("result"), tagged)).fetchone()
        if hit:
            smap[r["id"]] = hit["id"]
            dup_s += 1
            continue
        old = r.pop("id")
        r["superseded_by"], sup = None, r.get("superseded_by")
        r["result"] = tagged
        added_s.append((old, sup, r))

    def insert(t, r):
        cols = list(r)
        cur = c.execute(f"INSERT INTO {t}({','.join(cols)}) "
                        f"VALUES ({','.join('?' * len(cols))})", [r[k] for k in cols])
        return cur.lastrowid

    # Pass 1: every row in, links empty. Pass 2: the links, through the maps.
    # Two passes because a row may be superseded by one later in the file.
    for old, _, r in added_f:
        fmap[old] = insert("fact", r)
    lost_links = 0
    for old, _, r in added_s:
        fid = r.get("fact_id")
        if fid is not None and fid not in fmap:
            lost_links += 1        # names a fact the file does not contain
        r["fact_id"] = fmap.get(fid) if fid is not None else None
        smap[old] = insert("search", r)
    dangling = 0
    for t, added, m in (("fact", added_f, fmap), ("search", added_s, smap)):
        for old, sup, _ in added:
            if sup is None:
                continue
            if sup not in m:
                dangling += 1      # the file names a row it does not contain
                continue
            c.execute(f"UPDATE {t} SET superseded_by=? WHERE id=?", (m[sup], m[old]))

    def summary():
        print(f"merge from {a.path}  (label: {label})")
        print(f"  facts     {len(added_f):>6} added   {dup_f:>5} already here")
        print(f"  searches  {len(added_s):>6} added   {dup_s:>5} already here")
        if dangling:
            print(f"  WARNING: {dangling} superseded_by link(s) name a row the file "
                  f"does not contain; left empty")
        if lost_links:
            print(f"  WARNING: {lost_links} search row(s) link a fact the file "
                  f"does not contain; link left empty")
        print("  verify_cmd's were written for the SOURCE project's working "
              "directory; run\n  `know verify --cwd <that directory>` to "
              "re-check merged rows")

    if a.dry_run:
        c.rollback()
        summary()
        print("dry run: nothing written")
        return
    try:
        c.execute("INSERT INTO fact_fts(fact_fts, rank) VALUES('integrity-check', 1)")
    except sqlite3.DatabaseError as e:
        c.rollback()
        die(f"merge would have left the fact_fts index INCONSISTENT with its "
            f"content table: {e}\n       ROLLED BACK -- the store is unchanged.")
    c.commit()
    summary()
    print("  (fact_fts integrity verified)")


def cmd_stats(a):
    c = connect()
    print(f"store: {db_path()}")
    f = c.execute("SELECT COUNT(*) n, SUM(superseded_by IS NOT NULL) s, "
                  "SUM(verify_cmd IS NOT NULL) v FROM fact").fetchone()
    print(f"  facts      {f['n'] or 0:>7}   ({f['s'] or 0} superseded, "
          f"{f['v'] or 0} verifiable)")
    for r in c.execute("SELECT corroboration, COUNT(*) n FROM fact "
                       "GROUP BY corroboration ORDER BY 2 DESC"):
        print(f"    {r['corroboration']:<12} {r['n']:>5}   "
              f"{CORROB_MEANS.get(r['corroboration'], '')}")
    s = c.execute("SELECT COUNT(*) n, SUM(verdict='absent') a, "
                  "SUM(verdict='absent' AND verify_cmd IS NOT NULL) v, "
                  "SUM(verdict='absent' AND superseded_by IS NOT NULL) x "
                  "FROM search").fetchone()
    # `x` is reported because `verify --all` no longer sweeps those rows: a count
    # here that disagrees with the sweep's is a reader's first clue that
    # something is being skipped, and this is where they would look.
    print(f"  searches   {s['n'] or 0:>7}   ({s['a'] or 0} negative, "
          f"{s['v'] or 0} of them re-runnable, {s['x'] or 0} superseded)")
    for r in c.execute("SELECT corpus, COUNT(*) n, SUM(LENGTH(body)) b "
                       "FROM chunk GROUP BY corpus ORDER BY 2 DESC"):
        print(f"  {r['corpus']:<10} {r['n']:>7}   {(r['b'] or 0)/1e6:.1f} MB")
    t = c.execute("SELECT COUNT(*) n FROM chunk").fetchone()["n"]
    if t:
        print(f"  {'chunks':<10} {t:>7}")


INGEST_HELP = """\
With PATHs, each file is chunked as KIND. With no PATHs, the material comes from
the OS/2 library (PATHS.md), and nothing else on the disk is ever searched for.

What gets indexed, and as what:
  * every item's derived text/ and extracted tree/, plus the original it links
    to -- the same roots `os2-lib grep` reads, so the two agree about what the
    library contains;
  * items whose kind is not text (binaries, disc and VM images, dumps, installed
    system trees, toolchains) are skipped unless you name them with --role;
  * each file's chunker comes from its extension: .h/.inc/.c/.cpp/.asm/.def/.idl
    and friends -> source; .htm/.html -> html; .md -> md; a .txt is read to
    decide -- converted INF text (it carries its own '=== heading ===' markers)
    -> inf, anything else -> redbook, whose chunker falls back to fixed windows.
  Other extensions are skipped: they are not prose, and indexing them would only
  dilute the result list.

If the library holds nothing usable, this exits non-zero and names what is
missing rather than guessing at a path. Use --dry-run to see the plan first."""

VERIFY_HELP = """\
Re-runs each row's stored verify_cmd and reports AGREE / DISAGREE / UNCHECKABLE;
the exit code is the DISAGREE count. A negative's command is re-run too: one that
now FINDS something is reported CONTRADICTED, which is the most dangerous row in
the store, because a wrong 'absent' closes a question permanently.

Commands run from --cwd, which defaults to the current directory. WRITE A
verify_cmd THAT RUNS ANYWHERE: resolve library material by role rather than by
path, e.g.

  grep -n DosOpen "$(os2-lib role toolkit-headers headers)/bsedos.h"

A command that only works from one directory on one machine is a command the
next reader cannot run, which puts the row back to being a memory. And a
verify_cmd must be able to FAIL ON THE CONTESTED HALF: ask what it would print if
the claim were false in the specific way it can be false, then build that case
and run it."""


def main():
    ap = argparse.ArgumentParser(
        prog="know", description=__doc__.splitlines()[0],
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__[__doc__.index("STORE LOCATION"):])
    sub = ap.add_subparsers(dest="cmd")

    sub.add_parser("init", help="create/upgrade the store").set_defaults(fn=cmd_init)

    p = sub.add_parser("add", help="record a derived fact (citation REQUIRED)",
                       formatter_class=argparse.RawDescriptionHelpFormatter,
                       epilog=_CITE_HELP)
    p.add_argument("--subject", required=True)
    p.add_argument("--kind", required=True, choices=KIND)
    p.add_argument("--prov", required=True, choices=PROV)
    p.add_argument("--cite", required=True,
                   help="library role/item, book plus topic, file:line, or "
                        "binary plus offset")
    p.add_argument("--verify", help="ONE command that re-checks this claim, "
                                    "runnable from anywhere")
    p.add_argument("--verify2", help="the SECOND source's command; required "
                                     "for --corrob two-source")
    p.add_argument("--build", help="which binary/kernel/fixpak this is about")
    p.add_argument("--component")
    p.add_argument("--by", help="who or what derived it")
    p.add_argument("--corrob", required=True, choices=CORROB,
                   help="what the verification TOUCHES: "
                        + "; ".join(f"{k}={v}" for k, v in CORROB_MEANS.items()))
    p.add_argument("-m", "--message", required=True)
    p.set_defaults(fn=cmd_add)

    p = sub.add_parser("absent", help="record a search result, incl. a negative")
    p.add_argument("--question", required=True)
    p.add_argument("--tier", required=True, choices=TIER)
    p.add_argument("--target", required=True, help="what was ACTUALLY searched")
    p.add_argument("--verdict", default="absent",
                   choices=("hit", "absent", "partial"))
    p.add_argument("--result")
    p.add_argument("--verify", help="the exact command that found nothing, so "
                                    "`know verify` can catch it going stale")
    p.set_defaults(fn=cmd_absent)

    p = sub.add_parser("q", help="search facts and material")
    p.add_argument("query")
    p.add_argument("--limit", type=int, default=20,
                   help="default 20; recall@50 measured 24/25 for ~16.6k tokens")
    p.add_argument("--corpus", help="one chunker kind: "
                                    + "/".join(sorted(CHUNKERS)))
    p.add_argument("--component")
    p.add_argument("--facts", action="store_true", help="derived facts only")
    p.add_argument("--full", action="store_true", help="whole chunk, not a snippet")
    p.add_argument("--no-stale-check", action="store_true",
                   help="skip the staleness stat() pass (faster, less honest)")
    p.set_defaults(fn=cmd_q)

    p = sub.add_parser("show", help="one row in full, with its supersede chain")
    p.add_argument("id", help="a fact id (12) or a search/negative id (neg7)")
    p.set_defaults(fn=cmd_show)

    p = sub.add_parser("log", help="the search transcript for a question")
    p.add_argument("question")
    p.set_defaults(fn=cmd_log)

    p = sub.add_parser("supersede", help="correct a fact or a negative in place")
    # NOT type=int: a negative id (`neg7`) died in argparse with `invalid int
    # value`, so the one record type whose wrongness closes a question
    # permanently could never be retracted.
    p.add_argument("old", help="fact id (12) or negative id (neg7)")
    p.add_argument("by", help="its replacement, in the SAME table")
    p.add_argument("-m", "--message", required=True)
    p.set_defaults(fn=cmd_supersede)

    p = sub.add_parser("promote",
                       help="raise/correct a provenance tag (not automatable)")
    p.add_argument("id", type=int)
    p.add_argument("--prov", required=True, choices=PROV)
    p.add_argument("--corrob", required=True, choices=CORROB)
    p.add_argument("--evidence", required=True,
                   help="the NEW citation that justifies it")
    p.add_argument("--by", required=True, help="who authorised it")
    p.add_argument("--verify", help="command establishing the NEW basis; "
                                    "required when corroboration changes")
    p.add_argument("--verify2", help="second arm, for --corrob two-source")
    p.set_defaults(fn=cmd_promote)

    sub.add_parser("stale", help="source files that changed since ingest"
                   ).set_defaults(fn=cmd_stale)
    p = sub.add_parser("refresh", help="re-ingest what changed")
    p.add_argument("--prune", action="store_true",
                   help="also drop chunks for MISSING files (careful: an "
                        "unmounted disk looks missing)")
    p.set_defaults(fn=cmd_refresh)

    p = sub.add_parser("ingest", help="index material, from the library or by path",
                       formatter_class=argparse.RawDescriptionHelpFormatter,
                       epilog=INGEST_HELP)
    p.add_argument("kind", nargs="?", choices=sorted(CHUNKERS),
                   help="required with PATHs; with no PATHs, limits the library "
                        "ingest to this kind")
    p.add_argument("paths", nargs="*", help="explicit files; omit to use the library")
    p.add_argument("--role", help="only library items providing this role")
    p.add_argument("--category", help="only this library category")
    p.add_argument("--item", help="only this library item slug")
    p.add_argument("-n", "--dry-run", action="store_true",
                   help="list what would be ingested and write nothing")
    p.set_defaults(fn=cmd_ingest)

    p = sub.add_parser("verify", help="re-run stored verify commands",
                       formatter_class=argparse.RawDescriptionHelpFormatter,
                       epilog=VERIFY_HELP)
    # NOT type=int, for the reason `supersede` gives above: `verify neg7` died
    # in argparse, so a negative could be re-checked only by sweeping the store.
    p.add_argument("id", nargs="?", help="fact id (12) or negative id (neg7)")
    p.add_argument("--all", action="store_true")
    p.add_argument("--cwd", default=".",
                   help="working directory for every command (default: the "
                        "current directory)")
    p.set_defaults(fn=cmd_verify)

    p = sub.add_parser("export", help="readable prose + a lossless know.jsonl")
    p.add_argument("dir")
    p.set_defaults(fn=cmd_export)
    p = sub.add_parser("import", help="rebuild facts/searches from know.jsonl")
    p.add_argument("path")
    p.add_argument("--force", action="store_true",
                   help="REPLACE the store's facts and searches with the file's")
    p.add_argument("--merge", action="store_true",
                   help="ADD the file's rows to the store under new ids "
                        "(another project's export)")
    p.add_argument("--label",
                   help="with --merge: the source name recorded on each merged "
                        "row (default: the export's directory name)")
    p.add_argument("-n", "--dry-run", action="store_true",
                   help="with --merge: report what would be added, write nothing")
    p.set_defaults(fn=cmd_import)

    sub.add_parser("stats", help="what the store holds").set_defaults(fn=cmd_stats)

    a = ap.parse_args()
    if not a.cmd:
        ap.print_help()
        sys.exit(1)
    if a.cmd == "verify" and not a.all and a.id is None:
        die("verify needs an ID or --all")
    a.fn(a)


if __name__ == "__main__":
    main()
