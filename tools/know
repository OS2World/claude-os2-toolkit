def cmd_refresh(a):
    c = connect()
    changed, missing = stale_paths(c)
    if not changed and not (missing and a.prune):
        print("nothing to do"
              + (f" ({len(missing)} missing, left alone)" if missing else ""))
        return
    by_kind = {}
    for path, corpus, _ in changed:
        by_kind.setdefault(corpus, []).append(path)
    for kind, paths in by_kind.items():
        _ingest(kind, paths)
    if missing and a.prune:
        for path, corpus, n in missing:
            c.execute("DELETE FROM chunk WHERE path=?", (path,))
            print(f"pruned {n} chunks from missing {path}")
        c.commit()
    elif missing:
        print(f"{len(missing)} missing files left in place (--prune to drop them)")


def cmd_ingest(a):
    if a.paths:
        if not a.kind:
            die("ingest needs a KIND when you give explicit paths "
                f"({'/'.join(sorted(CHUNKERS))})")
        if a.role or a.category or a.item:
            die("--role/--category/--item select material FROM THE LIBRARY; "
                "they cannot be combined with explicit paths")
        if a.dry_run:
            for p in a.paths:
                print(f"{a.kind:<8} {p}")
            return
        _ingest(a.kind, [os.path.abspath(p) for p in a.paths])
        return
    if a.kind and a.kind not in CHUNKERS:
        die(f"unknown kind {a.kind!r} ({'/'.join(sorted(CHUNKERS))})")
    srcs = library_sources(category=a.category, role_name=a.role, slug=a.item,
                           want_kind=a.kind)
    by_kind, per_item = {}, {}
    for path, kind, it in srcs:
        by_kind.setdefault(kind, []).append(os.path.abspath(path))
        per_item[f"{it.category}/{it.slug}"] = per_item.get(
            f"{it.category}/{it.slug}", 0) + 1
    for name in sorted(per_item):
        print(f"{per_item[name]:>6} file(s)  {name}")
    if a.dry_run:
        print(f"\n-- dry run: {len(srcs)} file(s), "
              + ", ".join(f"{k}={len(v)}" for k, v in sorted(by_kind.items()))
              + " -- nothing written")
        return
    for kind in sorted(by_kind):
        _ingest(kind, by_kind[kind])


def _ingest(kind, paths):
    c = connect()
    fn = CHUNKERS[kind]
    nf = nc = 0
    for p in paths:
        try:
            text = open(p, encoding="utf-8", errors="replace").read()
        except OSError as e:
            print(f"skip {p}: {e}", file=sys.stderr)
            continue
        sha = hashlib.sha256(text.encode()).hexdigest()[:16]
        st = os.stat(p)
        rows = fn(text)
        if not rows:
            print(f"skip {p}: chunker produced 0 chunks", file=sys.stderr)
            continue
        c.execute("DELETE FROM chunk WHERE path=?", (p,))
        for i, (heading, body) in enumerate(rows):
            c.execute("INSERT INTO chunk(corpus,path,sha,section,heading,body,"
                      "size,mtime) VALUES (?,?,?,?,?,?,?,?)",
                      (kind, p, sha, i, heading, body,
                       int(st.st_size), int(st.st_mtime)))
        nf += 1
        nc += len(rows)
    c.commit()
    print(f"ingested {nf} files, {nc} chunks (kind={kind})")
    return nf, nc


def cmd_verify(a):
    """--all sweeps both tables; ONE id names a row in EITHER of them.

    The id goes through parse_row_id, the parser `show` and `supersede` use.
    It was `type=int`, so `verify neg7` died in argparse before any of this
    ran -- and a negative is the row type whose wrongness closes a question
    permanently, so it is the one that most needs re-checking by name rather
    than only inside a whole-store sweep.
    """
    c = connect()
    cwd = os.path.abspath(os.path.expanduser(a.cwd))
    if not os.path.isdir(cwd):
        die(f"--cwd {cwd} is not a directory")
    table = rid = None
    if not a.all:
        if a.id is None:
            die("give a row id (12 or neg7), or --all")
        table, rid = parse_row_id(a.id)
    if a.all:
        rows = c.execute("SELECT id,subject,verify_cmd,verify_cmd2,corroboration,"
                         "superseded_by FROM fact WHERE superseded_by IS NULL "
                         "ORDER BY id").fetchall()
    elif table == "fact":
        # NO superseded filter on a NAMED row, deliberately, and it is marked
        # below rather than silently included: the sweep's filter defines a
        # population (do not re-run what has been retracted), while naming an
        # id is an explicit request for that row.
        rows = c.execute("SELECT id,subject,verify_cmd,verify_cmd2,corroboration,"
                         "superseded_by FROM fact WHERE id=?", (rid,)).fetchall()
    else:
        rows = []
    if not rows and (a.all or table == "fact"):
        die(f"no {fmt_row_id('fact', rid)}" if rid else
            "nothing to verify (empty selection)", 1)
    for r in rows:
        if r["superseded_by"]:
            print(f"NOTE        {fmt_row_id('fact', r['id'])} is SUPERSEDED BY "
                  f"{fmt_row_id('fact', r['superseded_by'])} - out of the --all "
                  f"sweep; verifying it by name anyway")
    bad = unchecked = 0
    for r in rows:
        if not r["verify_cmd"]:
            unchecked += 1
            print(f"UNCHECKABLE #{r['id']:<5} {r['subject']}")
            continue
        cmds = [r["verify_cmd"]] + ([r["verify_cmd2"]] if r["verify_cmd2"] else [])
        results = []
        for cmd in cmds:
            try:
                p = subprocess.run(cmd, shell=True, capture_output=True,
                                   text=True, timeout=120, cwd=cwd)
                results.append(p.returncode == 0)
            except subprocess.TimeoutExpired:
                results.append(False)
        ok = all(results)          # two-source: BOTH sources must still agree
        arms = "" if len(results) < 2 else \
               f"  [{'+'.join('ok' if x else 'FAIL' for x in results)}]"
        print(f"{'AGREE' if ok else 'DISAGREE':<11} #{r['id']:<5} "
              f"{r['subject']}{arms}")
        bad += not ok
    # Every absent row, not just the ones that can be re-run. Filtering on
    # `verify_cmd IS NOT NULL` here made an unverifiable negative INVISIBLE,
    # while an unverifiable fact printed UNCHECKABLE -- so the half of the store
    # that closes questions permanently was the half that could hide.
    # `superseded_by IS NULL` mirrors the fact query above: a retracted negative
    # is out of the sweep, not deleted. The count is REPORTED below rather than
    # left implicit -- a row that silently stops being measured is the failure
    # this whole instrument is about.
    if a.all:
        negs = c.execute("SELECT id, question, target, verify_cmd, verdict, "
                         "superseded_by FROM search "
                         "WHERE verdict='absent' AND superseded_by IS NULL"
                         ).fetchall()
    elif table == "search":
        negs = c.execute("SELECT id, question, target, verify_cmd, verdict, "
                         "superseded_by FROM search WHERE id=?", (rid,)).fetchall()
        if not negs:
            die(f"no {fmt_row_id('search', rid)}", 1)
        # A NAMED ROW STILL HAS TO BE THE KIND THIS VERB CAN ASK ABOUT.
        # `verify` asks a search row one question -- is it STILL absent -- and
        # reads a command that now finds something as CONTRADICTED. For a row
        # whose recorded verdict IS a hit, finding something is the recorded
        # result, so that reading would print the row's own finding as its
        # refutation. Refused rather than answered.
        if negs[0]["verdict"] != "absent":
            die(f"{fmt_row_id('search', rid)} is a {negs[0]['verdict']!r} row, "
                f"not a negative.\n"
                f"       `verify` asks only whether a recorded ABSENCE still "
                f"holds; a row that recorded a\n"
                f"       hit cannot answer that. Read it with "
                f"`know show {fmt_row_id('search', rid)}`.")
        if negs[0]["superseded_by"]:
            print(f"NOTE        {fmt_row_id('search', rid)} is SUPERSEDED BY "
                  f"{fmt_row_id('search', negs[0]['superseded_by'])} - out of "
                  f"the --all sweep; verifying it by name anyway")
    else:
        negs = []
    neg_ok = neg_bad = neg_unchecked = 0
    for r in negs:
        if not r["verify_cmd"]:
            neg_unchecked += 1
            print(f"{'UNCHECKABLE':<12} neg#{r['id']:<4} {r['question'][:52]}")
            continue
        try:
            p = subprocess.run(r["verify_cmd"], shell=True, capture_output=True,
                               text=True, timeout=120, cwd=cwd)
            still_absent = p.returncode != 0 or not p.stdout.strip()
        except subprocess.TimeoutExpired:
            still_absent = False
        if still_absent:
            neg_ok += 1
            print(f"{'STILL ABSENT':<12} neg#{r['id']:<4} {r['question'][:52]}")
        else:
            neg_bad += 1
            print(f"{'CONTRADICTED':<12} neg#{r['id']:<4} {r['question'][:52]}")
            print(f"            -- the search that found nothing now finds "
                  f"something. This is the dangerous row: a wrong 'absent' "
                  f"closes a question permanently.")
    sup_f = sup_n = 0
    if a.all:
        sup_f = c.execute("SELECT COUNT(*) n FROM fact "
                          "WHERE superseded_by IS NOT NULL").fetchone()["n"]
        sup_n = c.execute("SELECT COUNT(*) n FROM search WHERE verdict='absent' "
                          "AND superseded_by IS NOT NULL").fetchone()["n"]
    print(f"\nfacts:     {len(rows)-bad-unchecked} agree, {bad} DISAGREE, "
          f"{unchecked} uncheckable (no verify_cmd)"
          + (f", {sup_f} superseded (not swept)" if sup_f else ""))
    if negs or sup_n:
        print(f"negatives: {neg_ok} still absent, {neg_bad} CONTRADICTED, "
              f"{neg_unchecked} uncheckable (no verify_cmd)"
              + (f", {sup_n} superseded (not swept)" if sup_n else ""))
    print(f"(commands ran with cwd={cwd})")
    bad += neg_bad
    if rows and unchecked and unchecked >= len(rows) / 2:
        print("WARNING: most rows carry no verify_cmd. If `verify` cannot be "
              "written for most\nrows, this store is a memory.")
    sys.exit(bad)


